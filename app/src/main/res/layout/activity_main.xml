<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <!-- Header Institucional -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary_blue"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serenazgo Municipal"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Central de Registro &amp; Despacho"
                android:textColor="#B0BEC5"
                android:textSize="13sp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSearchAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@android:color/white"
            android:contentDescription="Buscar DNI"/>
    </LinearLayout>

    <!-- Tarjeta Monitor Activo -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/card_white"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTotalVisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total visible: 0 casos"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnNuevaDenuncia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Nueva Denuncia"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/primary_blue"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="10dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filtros por Chip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPendientes"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendientes"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAtendidas"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atendidas"/>

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewDenuncias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- Botón Cargar Siguientes -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCargarSiguientes"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Cargar 5 siguientes"
        android:textAllCaps="false"
        android:textColor="@color/primary_blue"
        app:strokeColor="@color/primary_blue"
        app:cornerRadius="10dp"/>

</LinearLayout>
